{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "CoGS": {
    "Components": {
      "listener": {
        "Type": "KafkaListener",
        "Topic": "orders-in-staging",
        "ConsumerGroup": "order-service-staging",
        "ProduceIntervalMs": 3000
      },
      "dispatcher": {
        "Type": "KafkaDispatcher",
        "Topic": "orders-out-staging",
        "SubscribesTo": [
          "listener"
        ]
      }
    }
  }
}
