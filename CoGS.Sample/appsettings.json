{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "PipelineFeatures": {
    "EnableHighValueDispatcher": true,
    "EnableAuditDispatcher": false
  },

  "Listeners": {
    "EU": {
      "Topic": "orders-eu",
      "GroupId": "order-service-eu",
      "BootstrapServers": "kafka-eu:9092"
    }
  },
  "Dispatchers": {
    "Main": {
      "Topic": "orders-processed",
      "BootstrapServers": "kafka-eu:9092"
    },
    "HighValue": {
      "Topic": "orders-high-value",
      "BootstrapServers": "kafka-eu:9092"
    }
  }
}
