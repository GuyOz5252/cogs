{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "CoGS": "Information"
    }
  },
  "CoGS": {
    "Components": {
      "listener": {
        "Type": "KafkaListener",
        "Topic": "orders-in-prod",
        "ConsumerGroup": "order-service-prod",
        "ProduceIntervalMs": 500
      },
      "processor": {
        "Type": "OrderProcessor",
        "SubscribesTo": [
          {
            "Component": "listener",
            "Rule": "EventType:OrderReceived"
          }
        ]
      },
      "dispatcher": {
        "Type": "KafkaDispatcher",
        "Topic": "orders-all-prod",
        "SubscribesTo": [
          {
            "Component": "processor",
            "Rule": "EventType:OrderProcessed"
          }
        ]
      },
      "approval-dispatcher": {
        "Type": "KafkaDispatcher",
        "Topic": "orders-needing-approval",
        "SubscribesTo": [
          {
            "Component": "processor",
            "Rule": "EventType:OrderProcessed"
          }
        ]
      }
    }
  }
}
